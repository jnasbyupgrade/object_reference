# Temporary test files
test/temp_load.not_sql
test/dump/*.log

# Editor files
.*.swp

# Claude Code local settings
.claude/*.local.json

# Explicitly exclude META.json!
!/META.json

# Generated make files
meta.mk
control.mk

# Compiler output
*.o
*.so
.deps/

# built targets
# Note: Version-specific files (sql/*--*.sql) are now tracked in git and should be committed

# Test artifacts
results/
regression.diffs
regression.out

# Generated sql/ directory for test/build
# Created by make test-build. See README.asc for details.
test/build/sql/

# Auto-generated schedule file for test/install
# Created by make when test/install/*.sql files exist.
test/install/schedule

# pg_regress writes these here because the "../install/load" schedule entry
# resolves to the same path for both --inputdir/expected and
# --outputdir/results (see the comment at the top of test/install/load.sql)
# -- transient run artifacts, not committed expected output.
test/install/load.out
test/install/load.diff

# Misc
tmp/
.DS_Store

# pg_tle generated files
/pg_tle/
